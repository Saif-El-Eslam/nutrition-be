# Runtime (the API is only reachable through local Nginx)
NODE_ENV=production
ENVIRONMENT=production
HOST=127.0.0.1
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
DB_NAME=diet_wellness

# Authentication secrets (generate independent, high-entropy values)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Google Identity Services OAuth client IDs (comma-separated when multiple
# web/mobile clients use this API). Client IDs are public; no client secret is
# needed because this backend only verifies Google ID tokens.
GOOGLE_CLIENT_IDS=replace-with-web-client-id.apps.googleusercontent.com

# Public application URLs used by CORS, links, and payment callbacks
FRONTEND_URL=https://example.com
BACKEND_URL=https://api.example.com

# Transactional email
BUSINESS_EMAIL=notifications@example.com
GOOGLE_APP_PASSWORD=replace-with-an-app-password

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Paymob payments
PAYMOB_API_KEY=replace-with-api-key
PAYMOB_SECRET_KEY=replace-with-secret-key
PAYMOB_PUBLIC_KEY=replace-with-public-key
PAYMOB_IFRAME_ID=replace-with-iframe-id
PAYMOB_PAYMENT_INTEGRATION_ID=replace-with-integration-id
PAYMOB_WEBHOOK_SECRET=replace-with-webhook-secret

#
