{
  "name": "backend",
  "type": "module",
  "imports": {
    "#modules/*": "./src/modules/*",
    "#models/*": "./src/models/*",
    "#utils/*": "./src/utils/*",
    "#serializers/*": "./src/serializers/*",
    "#middlewares/*": "./src/middlewares/*",
    "#config/*": "./src/config/*"
  },
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node --check src/server.js && node --check src/app.js",
    "test": "node --test",
    "prod": "pm2 start ecosystem.config.cjs",
    "prod:stop": "pm2 stop backend",
    "prod:restart": "pm2 restart backend --update-env",
    "prod:logs": "pm2 logs backend",
    "prod:monit": "pm2 monit",
    "prod:delete": "pm2 delete backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "pm2": "^7.0.1"
  }
}
